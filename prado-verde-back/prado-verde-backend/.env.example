# Copia este archivo a ".env" y completa tus valores reales.
# Nunca subas el archivo ".env" real a un repositorio.

# Conexión a la base de datos creada con prado_verde_bd.sql
DATABASE_URL=postgres://usuario:clave@localhost:5432/prado_verde

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia_este_valor_por_uno_aleatorio_y_largo

# Puerto del servidor
PORT=4000

# Minutos de validez del código OTP enviado por SMS
OTP_EXP_MINUTES=5

# development | production
NODE_ENV=development

# --- Pasarela SMS (completar al integrar un proveedor real, ej. Twilio) ---
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Pasarela WhatsApp (completar al integrar un proveedor real) ---
WHATSAPP_PROVIDER=console
# Para Twilio WhatsApp:
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Para Meta Business API:
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=

# --- Pasarela Email (completar al integrar un proveedor real) ---
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@pradoverde.com
# Para SendGrid:
# SENDGRID_API_KEY=
# Para SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
