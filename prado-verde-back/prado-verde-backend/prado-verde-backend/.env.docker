# Configuración para Docker
NODE_ENV=production
PORT=4000

# Base de datos PostgreSQL
DB_USER=usuario
DB_PASSWORD=clave
DB_NAME=prado_verde
DB_PORT=5432

# Conexión a la base de datos (se genera automáticamente en docker-compose.yml)
# DATABASE_URL=postgres://usuario:clave@postgres:5432/prado_verde

# JWT Secret (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=cambia_este_valor_por_uno_aleatorio_y_largo_en_produccion

# OTP
OTP_EXP_MINUTES=5

# SMS Provider
SMS_PROVIDER=console
